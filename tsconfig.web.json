{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/deciphony-player.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    /* 检查未使用的变量 */
    "noUnusedParameters": false,
    /* 检查未使用的函数参数 */
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "deciphony-engine": [
        "../deciphony/packages/deciphony-engine/src/index.ts"
      ],
      "deciphony-engine*": [
        "../deciphony/packages/deciphony-engine/src/*"
      ],
      "vue": [
        "node_modules/vue"
      ],
      "vue-router": [
        "node_modules/vue-router"
      ],
      "element-plus": [
        "node_modules/element-plus"
      ],
      "gsap": [
        "node_modules/gsap"
      ],
      "@vue/reactivity": [
        "node_modules/@vue/reactivity"
      ],
      "@vue/runtime-core": [
        "node_modules/@vue/runtime-core"
      ]
    }
  }
}
